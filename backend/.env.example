RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# MSG91 WhatsApp Outbound & OTP Configuration
MSG91_WHATSAPP_AUTH_KEY=your_msg91_auth_key
MSG91_WHATSAPP_INTEGRATED_NUMBER=918110952245
MSG91_WHATSAPP_TEMPLATE_NAME=myhosur_property_account_otp_verification
MSG91_WHATSAPP_FORGOT_PASSWORD_TEMPLATE_NAME=myhosur_property_forgot_password_otp
MSG91_WHATSAPP_NAMESPACE=9dc986a5_2fc7_4562_8b79_9e65eb5da797
MSG91_WHATSAPP_LANG=en

# MSG91 WhatsApp Notification Templates (leave blank until templates are approved in MSG91 dashboard)
